# Local-development credentials for the loopback-bound Compose database only.
# Use deployment-specific credentials outside local/trusted development.
DATABASE_URL=postgresql+psycopg://nanexus:nanexus@localhost:5432/nanexus
# PUBLIC: browser origin and controlled CORS. Production values must be HTTPS.
PUBLIC_BASE_URL=http://127.0.0.1:8000
EVENT_INTELLIGENCE_PUBLIC_URL=http://127.0.0.1:8001
CORS_ALLOWED_ORIGINS=http://127.0.0.1:8080,http://localhost:8080

# SECURITY MODE: development is trusted-LAN only. Production fails closed unless
# static reference identity and service credential files exist. Never commit them.
DEPLOYMENT_MODE=development
AUTH_MODE=development
AUTH_TOKENS_FILE=
SERVICE_TOKEN_FILE=
CAPABILITY_CHECK_ENABLED=false

# INTERNAL addresses: never expose these values in client responses or logs.
REDIS_URL=redis://localhost:6379/0
# Local demo Mosquitto (docker compose maps 1884 to loopback). It permits
# anonymous clients for local development and must not be exposed externally.
# For a real Frigate host, set MQTT_HOST to that machine and MQTT_PORT=1883.
MQTT_HOST=localhost
MQTT_PORT=1884
MQTT_TOPIC=frigate/events
# Example real Frigate:
# MQTT_HOST=<FRIGATE_HOST>
# MQTT_PORT=1883
# FRIGATE_BASE_URL=http://<FRIGATE_HOST>:5000
FRIGATE_BASE_URL=http://localhost:5000
FRIGATE_TOKEN=
EVENT_INTELLIGENCE_URL=http://event-intelligence:8000
# Optional local source checkout used only by integrated/slice Compose builds.
# The default expects a sibling checkout named nanexus-event-intelligence.
EVENT_INTELLIGENCE_SOURCE_DIR=../nanexus-event-intelligence
# SECRET: use Compose secret/file injection in production. This literal form is
# retained for trusted-LAN compatibility only.
EVENT_INTELLIGENCE_TOKEN=
EVENT_INTELLIGENCE_TIMEOUT_SECONDS=10
EVENT_INTELLIGENCE_POLL_SECONDS=1
# Event Intelligence enrichment worker: stub | openclip. Cloud providers unsupported.
MODEL_PROVIDER=stub
MODEL_TIMEOUT_SECONDS=60
MODEL_MAX_IMAGE_BYTES=10485760
# Rollback-only legacy Search inference; keep false for API process isolation.
LEGACY_API_MODEL_INFERENCE_ENABLED=false
EMBEDDING_DIM=512
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO

# Legacy AI-worker path only (stub | openclip). Independent of MODEL_PROVIDER;
# do not infer the current v1 provider from AI_MODE or GET /health.ai_mode.
AI_MODE=openclip
# auto | cpu | cuda. cuda fails closed if CUDA is unavailable; use compose.gpu.yaml
# for the GPU container profile. Default Linux OpenCLIP remains CPU.
AI_DEVICE=auto
OPENCLIP_MODEL=ViT-B-32-quickgelu
OPENCLIP_PRETRAINED=openai
SNAPSHOTS_DIR=data/snapshots

# Summary worker: rule | llm
SUMMARY_MODE=rule
SUMMARY_HOUR=23
SUMMARY_MINUTE=50
SUMMARY_TIMEZONE=UTC
SUMMARY_SITE_ID=default
SUMMARY_RULE_VERSION=rule-v1
SUMMARY_PROMPT_VERSION=daily-security-v1
SUMMARY_LLM_MAX_INPUT_CHARS=16000
SUMMARY_LLM_MAX_TOKENS=700
# Configured worst-case request budget ($0.025) and provider price assumptions.
SUMMARY_LLM_MAX_COST_MICROS=25000
SUMMARY_LLM_INPUT_COST_PER_MILLION_MICROS=1000000
SUMMARY_LLM_OUTPUT_COST_PER_MILLION_MICROS=10000000

# Chat: extractive | llm
CHAT_MODE=extractive
CHAT_LOOKBACK_DAYS=3
CHAT_QUEUE_KEY=nanexus:chat:jobs
CHAT_CONTEXT_SUBJECT_LIMIT=8
CHAT_MAX_CONTEXT_CHARS=12000
CHAT_MAX_OUTPUT_TOKENS=500
CHAT_MAX_OUTPUT_CHARS=4000
CHAT_LLM_INPUT_COST_PER_MILLION_MICROS=1000000
CHAT_LLM_OUTPUT_COST_PER_MILLION_MICROS=10000000

# Optional OpenAI-compatible LLM
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=60

# Search: API calls this worker-only model service; it never imports OpenCLIP.
MODEL_SERVICE_URL=http://model-service:8010
EMBEDDING_QUEUE_KEY=nanexus:search:embedding-jobs
EMBEDDING_DLQ_KEY=nanexus:search:embedding-dlq
EMBEDDING_MAX_ATTEMPTS=3
# Optional active-model pin. Leave empty to use the model-service identity.
SEARCH_MODEL=
SEARCH_MODEL_VERSION=
