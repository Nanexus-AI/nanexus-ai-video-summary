FROM python:3.12-slim
WORKDIR /app
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
RUN pip install --no-cache-dir "httpx>=0.28,<1" "pydantic>=2.10,<3" "pydantic-settings>=2.6,<3" "Pillow>=10,<13"
COPY src ./src
COPY services ./services
ENV PYTHONPATH=/app/src:/app
CMD ["python", "-m", "services.event_intelligence_worker.main"]
