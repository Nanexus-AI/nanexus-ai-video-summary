FROM ghcr.io/astral-sh/uv:python3.12-bookworm-slim
WORKDIR /app
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PYTHONPATH=/app/src:/app PATH=/app/.venv/bin:$PATH
COPY pyproject.toml uv.lock README.md ./
COPY src ./src
COPY services ./services
ARG MODEL_PROFILE=stub
RUN if [ "$MODEL_PROFILE" = "openclip" ]; then uv sync --frozen --no-dev --extra openclip; else uv sync --frozen --no-dev; fi
CMD ["python", "-m", "services.event_intelligence_worker.main"]
